# =============================================================================
# RBAC Admin Panel — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# In production, configure these variables in Vercel's Environment Variables dashboard.
# NEVER commit .env, .env.local, or .env.production to version control.
# =============================================================================

# ─── DATABASE (Railway MySQL) ─────────────────────────────────────────────────
# Provided by Railway after adding a MySQL plugin.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# A long, random, secret string used to sign JWT session tokens.
# Generate with: openssl rand -base64 64
# REQUIRED in production — the app will refuse to start without this.
JWT_SECRET=

# ─── PUBLIC APP CONFIG ────────────────────────────────────────────────────────
# The canonical public URL of the deployed application.
# Example (Vercel): https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional: Override the application display name shown in the UI.
NEXT_PUBLIC_APP_NAME=OmniCommerce Admin